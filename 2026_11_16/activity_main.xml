<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    android:background="#B0C4DE">


    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dane pracownika" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/textViewName"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Imię" />

        <EditText
            android:id="@+id/editTextName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/textViewSurname"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Nazwisko"/>

        <EditText
            android:id="@+id/editTextSurname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text=""/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/textViewPosition"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stanowisko" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generowanie hasła"
        android:layout_marginTop="40dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/textViewChars"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ile znaków?" />

        <EditText
            android:id="@+id/editTextChars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ems="10"
            android:inputType="number" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <CheckBox
            android:id="@+id/checkBoxLetters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Małe i wielkie litery"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/checkBoxDigits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cyfry" />

        <CheckBox
            android:id="@+id/checkBoxSpecial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Znaki specjalne" />

        <Button
            android:id="@+id/buttonGeneratePass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generuj hasło"
            android:layout_gravity="center"
            android:backgroundTint="#4682B4"
            android:textColor="@color/white"/>
    </LinearLayout>

    <Button
        android:id="@+id/buttonConfirm"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Zatwierdź"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:backgroundTint="#4682B4"
        android:textColor="@color/white" />

</LinearLayout>